{
    "name": "taoser/taoler",
    "description": "TaoLerCMS",
    "type": "project",
    "keywords": [
        "taoler",
        "thinkphp",
        "CMS"
    ],
    "homepage": "https://www.aieok.com/",
    "license": "Apache-2.0",
    "authors": [
        {
            "name": "taoser",
            "email": "changlin_zhao@qq.com"
        }       
    ],
    "require": {
        "php": ">=8.0.0",
        "topthink/framework": "^8.1",
        "topthink/think-orm": "^4.0",
        "topthink/think-filesystem": "^3.0",
        "topthink/think-captcha": "^3.0",
        "topthink/think-throttle": "^3.0",
        "taoser/think-addons": "^2.2",
        "taoser/think-auth": "^2.0",
        "taoser/think-setarr": "^0.0.5",
        "firebase/php-jwt": "^7.1",
        "guzzlehttp/guzzle": "^7.14",
        "workerman/workerman": "^5.2",
        "workerman/gateway-worker": "^4.0",
        "workerman/gatewayclient": "^3.1",
        "phpmailer/phpmailer": "^7.1",
        "intervention/image": "^4.1",
        "endroid/qr-code": "^6.1",
        "sqids/sqids": "^0.5.0",
        "overtrue/easy-sms": "^3.3",
        "yansongda/pay": "~3.7.0",
        "illuminate/container": "^13.19"
    },
    "require-dev": {
        "topthink/think-dumper": "^1.0",
        "topthink/think-trace": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "app\\": "app"
        },
        "psr-0": {
            "": "extend/"
        },
		"files": [
			"extend/taoler/com/form.php"
		]
    },
    "config": {
        "preferred-install": "dist"
    },
    "scripts": {
        "post-autoload-dump": [
            "@php think service:discover",
            "@php think vendor:publish"
        ]
    }
}
