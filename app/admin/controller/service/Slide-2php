<?php
namespace app\admin\controller\service;

use app\model\SlideGroup;
use app\model\SlideItem;
use think\Request;
use think\Validate;
use think\facade\View;
use app\admin\controller\AdminBaseController;

class Slide extends AdminBaseController
{
    /**
     * 【唯一管理页面】分组+子项 同页
     */
    public function index()
    {
        return View::fetch();
    }

    /**
     * 分组数据接口 layui table
     */
    public function groupData(Request $req)
    {
        $page = $req->param('page',1);
        $limit = $req->param('limit',10);
        $list = SlideGroup::paginate([
            'page'=>$page,
            'list_rows'=>$limit
        ]);
        return json([
            'code'=>0,
            'msg'=>'',
            'count'=>$list->total(),
            'data'=>$list->items()
        ]);
    }

    /**
     * 分组新增/编辑弹窗
     */
    public function groupForm(Request $request)
    {
        $id = $request->get('id', 0);
        $info = [];
        if($id){
            $info = SlideGroup::find($id);
        }
        return View::fetch('group_form', ['info'=>$info]);
    }

    /**
     * 保存分组
     */
    public function groupSave(Request $req)
    {
        $data = $req->post();
        $validate = new Validate([
            'name'=>'require',
            'code'=>'require|alphaDash|unique:slide_group,code,'.($data['id']??0)
        ],[
            'name.require'=>'分组名称不能为空',
            'code.require'=>'分组标识不能为空',
            'code.alphaDash'=>'标识只能字母数字下划线',
            'code.unique'=>'标识已存在'
        ]);
        if(!$validate->check($data)){
            return json(['code'=>1,'msg'=>$validate->getError()]);
        }
        if(!empty($data['id'])){
            $model = SlideGroup::find($data['id']);
        }else{
            $model = new SlideGroup();
        }
        $model->save($data);
        return json(['code'=>0,'msg'=>'保存成功']);
    }

    /**
     * 删除分组（事务级联软删除子项）
     */
    public function groupDel(Request $req)
    {
        $id = $req->param('id');
        \think\facade\Db::startTrans();
        try {
            SlideGroup::destroy($id);
            SlideItem::where('group_id', $id)->delete();
            \think\facade\Db::commit();
            return json(['code'=>0,'msg'=>'删除成功，分组下幻灯子项已同步删除']);
        }catch (\Exception $e){
            \think\facade\Db::rollback();
            return json(['code'=>1,'msg'=>'删除失败：'.$e->getMessage()]);
        }
    }

    // ========== 幻灯子项 ==========
    /**
     * 子项table数据（展开行调用，无分页）
     */
    public function itemData(Request $req)
    {
        $groupId = $req->param('group_id',0);
         $slideItem = new SlideItem();
        $list = $slideItem->where('group_id',$groupId)
            ->order('sort desc,id desc')
            ->select();
        return json([
            'code'=>0,
            'msg'=>'',
            'data'=>$list->toArray()
        ]);
    }

    /**
     * 子项新增/编辑弹窗
     */
    public function itemForm(Request $request)
    {
        $id = $request->get('id',0);
        $groupId = $request->get('group_id',0);
        $info = [];
        if($id){
            $slideItem = new SlideItem();
            $info = $slideItem->find($id);
            $groupId = $info['group_id'];
        }

        return View::fetch('item_form', [
            'info'=>$info,
            'group_id'=>$groupId
        ]);
    }

    /**
     * 保存幻灯子项（datetime直接接收前端日期字符串，不再转时间戳）
     */
    public function itemSave(Request $req)
    {
        $data = $req->post();

        $validate = new Validate([
            'group_id'=>'require',
            'title'=>'require',
            'image'=>'require',
            'start_time'=>'require|date',
            'end_time'=>'require|date|after:start_time'
        ],[
            'group_id.require'=>'分组不能为空',
            'title.require'=>'标题不能为空',
            'image.require'=>'图片不能为空',
            'start_time.require'=>'开始时间不能为空',
            'start_time.date'=>'开始时间格式错误',
            'end_time.require'=>'结束时间不能为空',
            'end_time.date'=>'结束时间格式错误',
            'end_time.after'=>'结束时间必须晚于开始时间'
        ]);
        if(!$validate->check($data)){
            return json(['code'=>1,'msg'=>$validate->getError()]);
        }
        if(!empty($data['id'])){
            $model = SlideItem::find($data['id']);
        }else{
            $model = new SlideItem();
        }
        $model->save($data);
        return json(['code'=>0,'msg'=>'保存成功']);
    }

    /**
     * 删除幻灯子项
     */
    public function itemDel(Request $req)
    {
        $id = $req->param('id');
        SlideItem::destroy($id);
        return json(['code'=>0,'msg'=>'删除成功']);
    }
}
